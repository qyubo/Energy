{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32 Debug (ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/RM26_F4.elf",
            "gdbPath": "D:/OpenOCD/OpenOCD/arm-none-eabi-gdb.exe",
            "serverpath": "D:/OpenOCD/OpenOCD/bin/openocd.exe",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "device": "STM32F407IGH6",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 20
            },
            "svdFile": "${workspaceFolder}/STM32F407.svd"
        },
        {
            "name": "STM32 Debug (CMSIS-DAP, if connected)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/RM26_F4.elf",
            "gdbPath": "D:/OpenOCD/OpenOCD/arm-none-eabi-gdb.exe",
            "serverpath": "D:/OpenOCD/OpenOCD/bin/openocd.exe",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "device": "STM32F407IGH6",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 20
            },
            "svdFile": "${workspaceFolder}/STM32F407.svd"
        }
    ]
}

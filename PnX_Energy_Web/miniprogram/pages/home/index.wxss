page { background:#07110f; color:#eef8f4; }
.page{min-height:100vh;background:radial-gradient(circle at 88% 8%,rgba(33,211,145,.17),transparent 34%),#07110f;box-sizing:border-box;padding:calc(env(safe-area-inset-top) + 28rpx) 32rpx calc(env(safe-area-inset-bottom) + 32rpx);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
.topbar{display:flex;justify-content:space-between;align-items:center;padding:12rpx 4rpx 34rpx}.brand{font-size:38rpx;font-weight:800;letter-spacing:1rpx}.subtitle{font-size:22rpx;color:#729489;margin-top:5rpx}.connection{display:flex;align-items:center;border:1rpx solid #28433b;border-radius:999rpx;padding:14rpx 20rpx;color:#8ca39c;font-size:22rpx;background:rgba(12,31,26,.8)}.dot{width:12rpx;height:12rpx;border-radius:50%;background:#63716d;margin-right:12rpx}.connection.online{color:#79efbd;border-color:#1e684f}.connection.online .dot{background:#31e59d;box-shadow:0 0 18rpx #31e59d}.connection.waiting .dot{background:#f0ba4b}.demo-banner{background:#5a4413;color:#ffdc84;padding:18rpx 24rpx;border-radius:16rpx;margin-bottom:22rpx;text-align:center;font-size:23rpx}.content{animation:rise .25s ease}.hero-card{padding:42rpx 36rpx;border:1rpx solid #24443a;border-radius:30rpx;background:linear-gradient(145deg,rgba(18,48,39,.96),rgba(9,26,22,.92));box-shadow:0 24rpx 60rpx rgba(0,0,0,.18)}.eyebrow{color:#37dda0;font-size:20rpx;letter-spacing:4rpx;font-weight:700}.hero-title,.section-title{font-size:48rpx;font-weight:800;margin-top:14rpx}.hero-desc{color:#91aaa1;font-size:25rpx;line-height:1.75;margin-top:18rpx}.connect-row{display:flex;gap:18rpx;margin-top:34rpx}.button{height:88rpx;line-height:88rpx;border-radius:20rpx;font-size:27rpx;font-weight:700;margin:0;padding:0 32rpx}.button::after,.mode-card::after,.device::after,.judge::after,.text-button::after{border:none}.primary{background:#32e2a0;color:#052218}.ghost{background:#122a24;color:#d6e7e1;border:1rpx solid #315247}.danger-ghost{background:#2a1718;color:#ffb2ac;border:1rpx solid #633332}.full{width:100%;margin-top:24rpx}.mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:22rpx}.mode-card{text-align:left;height:360rpx;padding:30rpx;border-radius:26rpx;color:#eaf7f2;background:#102921;border:1rpx solid #284b3f;display:flex;flex-direction:column;align-items:stretch;line-height:1.3}.mode-card.large{background:#181d2a;border-color:#35405a}.mode-card[disabled]{opacity:.36}.mode-index{font-size:21rpx;color:#72a594;letter-spacing:3rpx}.mode-title{font-size:36rpx;font-weight:800;margin-top:42rpx}.mode-desc{font-size:23rpx;color:#8da39b;line-height:1.6;margin-top:15rpx;white-space:normal}.mode-action{margin-top:auto;color:#47e2aa;font-size:23rpx;font-weight:700}.error-box{background:#321a1d;color:#ffc0bc;border:1rpx solid #673037;padding:20rpx 24rpx;border-radius:16rpx;margin-top:22rpx;font-size:23rpx;line-height:1.5}.section-head,.test-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:30rpx}.text-button{background:transparent;color:#9fbbb1;font-size:25rpx;padding:15rpx;margin:0}.text-button.danger{color:#ff918a}.device-tip{padding:22rpx;border-radius:16rpx;background:#102821;color:#8ca69d;font-size:23rpx;line-height:1.55;margin-bottom:18rpx}.device-list{height:60vh}.device{width:100%;display:flex;align-items:center;justify-content:space-between;background:#0e221d;color:#edf8f4;border:1rpx solid #234038;border-radius:20rpx;padding:26rpx;margin:12rpx 0;text-align:left;line-height:1.4}.device-name{font-size:29rpx;font-weight:700}.device-id{font-size:19rpx;color:#68867c;margin-top:8rpx;max-width:480rpx;overflow:hidden;text-overflow:ellipsis}.rssi{font-size:21rpx;color:#43d9a3}.empty{text-align:center;color:#6f8b81;padding:110rpx 20rpx}.progress{display:flex;justify-content:space-between;position:relative;margin:45rpx 10rpx 55rpx}.progress::before{content:"";position:absolute;top:29rpx;left:48rpx;right:48rpx;height:2rpx;background:#27463c}.step{position:relative;text-align:center;color:#668078}.step-dot{width:58rpx;height:58rpx;line-height:58rpx;border-radius:50%;background:#10251f;border:2rpx solid #355349;font-size:22rpx}.step.done .step-dot{background:#31df9e;border-color:#31df9e;color:#052218}.step-label{font-size:19rpx;margin-top:12rpx}.target-card{position:relative;text-align:center;border-radius:34rpx;padding:64rpx 30rpx 50rpx;background:linear-gradient(180deg,#12382d,#0b211b);border:1rpx solid #2d5b4b;overflow:hidden}.pulse{position:absolute;width:360rpx;height:360rpx;border-radius:50%;border:1rpx solid rgba(52,225,162,.16);left:50%;top:45%;transform:translate(-50%,-50%);box-shadow:0 0 0 45rpx rgba(52,225,162,.025),0 0 0 90rpx rgba(52,225,162,.018)}.target-label{position:relative;color:#46dda8;font-size:20rpx;letter-spacing:4rpx}.target-number{position:relative;font-size:150rpx;line-height:1.05;font-weight:900;margin-top:16rpx}.target-unit{position:relative;color:#94aca4;font-size:26rpx}.target-text{position:relative;margin-top:28rpx;color:#afc3bc;font-size:24rpx}.judge-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:22rpx}.judge{height:156rpx;border-radius:26rpx;color:#052219;background:#35dfa0;font-size:29rpx;font-weight:800;display:flex;align-items:center;justify-content:center;gap:18rpx}.judge.miss{color:#ffb3ad;background:#30191b;border:1rpx solid #653336}.judge[disabled]{opacity:.35}.judge-symbol{font-size:52rpx}.complete{text-align:center;padding-top:74rpx}.complete-ring{width:180rpx;height:180rpx;border:2rpx solid #35e2a1;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 42rpx;box-shadow:0 0 60rpx rgba(53,226,161,.22)}.complete-check{width:116rpx;height:116rpx;line-height:116rpx;border-radius:50%;background:#35e2a1;color:#052218;font-size:58rpx;font-weight:900}.complete-title{font-size:52rpx;font-weight:900;margin-top:17rpx}.complete-desc{font-size:25rpx;color:#8da69d;margin:20rpx auto 42rpx;line-height:1.6}.summary{background:#0e241e;border:1rpx solid #29463d;border-radius:24rpx;padding:12rpx 28rpx;margin-bottom:38rpx}.summary view{display:flex;justify-content:space-between;border-bottom:1rpx solid #1e3931;padding:24rpx 0;color:#819b92;font-size:24rpx}.summary view:last-child{border-bottom:0}.summary strong{color:#edf8f4}@keyframes rise{from{opacity:0;transform:translateY(12rpx)}to{opacity:1;transform:none}}

  OBJECT_DIR = CMakeFiles\WS2812_temp.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = WS2812_temp.elf
  TARGET_PDB = WS2812_temp.elf.dbg



  LINK_FLAGS = -mcpu=cortex-m3  -T "D:/project/Temp_energy/STM32F103XX_FLASH.ld" --specs=nano.specs -Wl,-Map=WS2812_temp.map -Wl,--gc-sections -Wl,--print-memory-usage
